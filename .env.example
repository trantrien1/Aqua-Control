# Sao chép file này thành `.env` rồi sửa theo nhu cầu.
# Mọi biến đều có giá trị mặc định trong server/config.js nên `.env` là tuỳ chọn.

# ---------------------------------------------------------------- HTTP / API ---
# Cổng của dashboard và API. Nếu bị chiếm, đổi sang 3001, 8080...
PORT=3000
# 0.0.0.0 để điện thoại / ESP32 trong LAN truy cập được.
HOST=0.0.0.0

# --------------------------------------------------------------- đăng nhập ---
# Mật khẩu của tài khoản quản trị `admin`, chỉ dùng lần đầu để tạo tài khoản.
# Đổi ngay sau khi đăng nhập lần đầu, hoặc đặt ở đây trước khi chạy lần đầu.
# Khách hàng do quản trị viên tạo trong mục "Quản trị" trên web.
ADMIN_PASSWORD=beca123
# Thời hạn phiên đăng nhập (giây). Mặc định 7 ngày.
SESSION_TTL_SECONDS=604800
# Khoá ký cookie phiên. Để trống thì hệ thống tự sinh và lưu ở data/.session-secret.
# SESSION_SECRET=

# -------------------------------------------------------------------- MQTT ---
# Broker nhúng trong tiến trình Node (không cần cài Mosquitto).
EMBEDDED_BROKER=true
# Cổng MQTT cho ESP32 kết nối vào.
MQTT_PORT=1883
# Tiền tố topic. Đổi thì phải đổi cả TOPIC_PREFIX trong firmware.
MQTT_TOPIC_PREFIX=aquarium
# Thiết bị không còn khai báo trong .env: quản trị viên cấp trong web, mỗi thiết
# bị nhận một DEVICE_ID và DEVICE_KEY riêng để nạp vào firmware.

# Tài khoản của chính máy chủ khi nói chuyện với broker.
# Để trống thì hệ thống tự sinh và dùng SESSION_SECRET làm mật khẩu.
# MQTT_SERVER_USERNAME=
# MQTT_SERVER_PASSWORD=

# Nếu dùng broker ngoài (Mosquitto, HiveMQ...):
# EMBEDDED_BROKER=false
# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# ------------------------------------------------------------ xử lý dữ liệu ---
# Không nhận được dữ liệu trong bao nhiêu giây thì coi thiết bị mất kết nối.
STALE_AFTER_SECONDS=60
# Thời gian chờ ESP32 xác nhận lệnh relay (mili giây).
COMMAND_ACK_TIMEOUT_MS=8000
# Giãn cách tối thiểu giữa hai cảnh báo cùng loại (chống spam).
ALERT_COOLDOWN_SECONDS=180
# Số ngày giữ dữ liệu đo và cảnh báo trong SQLite.
RETENTION_DAYS=30

# --------------------------------------------------------------- Telegram ---
# Token lấy từ @BotFather. Để trống thì tắt hẳn tính năng thông báo.
# Mỗi khách hàng tự liên kết chat id riêng trên trang web (nút "Liên kết Telegram"),
# KHÔNG khai báo chat id trong .env nữa.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# Mức thông báo: "critical" chỉ báo vùng đỏ, "warn" báo cả vùng vàng (mặc định).
# TELEGRAM_NOTIFY_LEVEL=warn
# Nhắc lại khi thông số vẫn còn xấu (phút). Khách tắt được ngay trong bot bằng /tat.
# TELEGRAM_REPEAT_WARN_MINUTES=30
# TELEGRAM_REPEAT_CRITICAL_MINUTES=10
# Địa chỉ dashboard gắn trong tin nhắn, ví dụ http://192.168.1.10:3000
# PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------- dữ liệu ---
# Đường dẫn file SQLite. Mặc định <project>/data/aquarium.db
# DB_PATH=D:/du-lieu/aquarium.db
